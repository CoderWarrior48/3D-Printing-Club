{
  "expo": {
    "name": "3dpc-app",
    "slug": "3dpc-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/3dpc.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.do3dpc.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/3dpc.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.do3dpc.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/3dpc.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e744227b-73fe-412f-9abd-950e92c3ea43"
      }
    }
  }
}
